POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
JWT_SECRET=troque-esta-chave-em-ambientes-reais
TELEMETRY_PORT=9050
ROUTING_PORT=8082
INTEGRATION_ENGINE_PORT=9060
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_PORT=9092
MQTT_PORT=1883
INTEGRATION_PORT=9060
# Para homologação SERPRO, use docker,homologation e preencha via cofre de segredos.
INTEGRATION_PROFILES=docker,cte-homologation
INFOSIMPLES_SERPRO_RADAR_URL=
INFOSIMPLES_TOKEN=
INFOSIMPLES_SERPRO_INTERNAL_API_KEY=

# CT-e 4.00 — endpoints independentes por operação
SEFAZ_CTE_AMBIENTE=homologacao
SEFAZ_CTE_AUTORIZACAO_URL=https://homologacao.sefaz.mt.gov.br/ctews2/services/CTeRecepcaoSincV4
SEFAZ_CTE_CONSULTA_URL=https://homologacao.sefaz.mt.gov.br/ctews2/services/CTeConsultaV4
SEFAZ_CTE_EVENTO_URL=https://homologacao.sefaz.mt.gov.br/ctews2/services/CTeRecepcaoEventoV4
SEFAZ_CTE_STATUS_URL=https://homologacao.sefaz.mt.gov.br/ctews2/services/CTeStatusServicoV4
SEFAZ_CERT_PATH=
SEFAZ_CERT_PASSWORD=
SEFAZ_CERT_KEY_PASSWORD=
SEFAZ_CERT_TYPE=PKCS12
# Opcional: vazio usa as autoridades certificadoras confiáveis do Java.
SEFAZ_TRUSTSTORE_PATH=
SEFAZ_TRUSTSTORE_PASSWORD=
SEFAZ_TRUSTSTORE_TYPE=PKCS12
SEFAZ_TLS_PROTOCOL=TLSv1.2
