# Copie para um .env fora do versionamento e preencha com os endpoints da UF autorizadora.
SPRING_PROFILES_ACTIVE=nfe-homologation
INTEGRATION_SIMULATION_ENABLED=false

SEFAZ_NFE_CODIGO_UF=51
SEFAZ_NFE_AUTORIZACAO_URL=https://CHANGE_ME_NFE_AUTORIZACAO
SEFAZ_NFE_RET_AUTORIZACAO_URL=https://CHANGE_ME_NFE_RET_AUTORIZACAO
SEFAZ_NFE_CONSULTA_URL=https://CHANGE_ME_NFE_CONSULTA
SEFAZ_NFE_EVENTO_URL=https://CHANGE_ME_NFE_EVENTO
SEFAZ_NFE_INUTILIZACAO_URL=https://CHANGE_ME_NFE_INUTILIZACAO
SEFAZ_NFE_STATUS_SERVICO_URL=https://CHANGE_ME_NFE_STATUS
SEFAZ_NFE_DISTRIBUICAO_DFE_URL=https://CHANGE_ME_NFE_DISTRIBUICAO_DFE

SEFAZ_CERT_PATH=/run/secrets/sefaz-a1.p12
SEFAZ_CERT_PASSWORD=CHANGE_ME_CERTIFICATE_PASSWORD
SEFAZ_CERT_KEY_PASSWORD=CHANGE_ME_PRIVATE_KEY_PASSWORD
SEFAZ_CERT_TYPE=PKCS12
SEFAZ_TLS_PROTOCOL=TLSv1.2

# Mantenha todas as operações mutáveis bloqueadas até aprovação fiscal explícita.
SEFAZ_NFE_AUTHORIZATION_ENABLED=false
SEFAZ_NFE_EVENT_ENABLED=false
SEFAZ_NFE_INUTILIZATION_ENABLED=false
SEFAZ_NFE_AUTHORIZED_FISCAL_TEST_DATA=false
