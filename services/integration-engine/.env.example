# Copie este arquivo para .env e preencha a senha antes de iniciar os containers.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-por-uma-senha-forte
INTEGRATION_PORT=9060
TZ=America/Cuiaba

# Certificados nunca entram na imagem. Informe caminhos visíveis dentro do container
# somente quando usar um override Compose que monte os arquivos como somente leitura.
SEFAZ_CERT_PATH=
SEFAZ_CERT_PASSWORD=
SEFAZ_CERT_KEY_PASSWORD=
SEFAZ_CERT_TYPE=PKCS12
SEFAZ_TRUSTSTORE_PATH=
SEFAZ_TRUSTSTORE_PASSWORD=
SEFAZ_TRUSTSTORE_TYPE=PKCS12
SEFAZ_TLS_PROTOCOL=TLSv1.2
