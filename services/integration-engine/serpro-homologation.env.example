# Copie para um arquivo .env não versionado ou cadastre os valores no cofre de segredos.
# Nunca substitua os placeholders neste arquivo de exemplo.
SPRING_PROFILES_ACTIVE=docker,homologation
INTEGRATION_PORT=9060

INFOSIMPLES_SERPRO_RADAR_URL=https://CHANGE_ME_ENDPOINT_HOMOLOGACAO
INFOSIMPLES_TOKEN=CHANGE_ME_PROVIDER_TOKEN_MIN_16_CHARS
INFOSIMPLES_SERPRO_INTERNAL_API_KEY=CHANGE_ME_INTERNAL_API_KEY_MIN_16_CHARS

INFOSIMPLES_SERPRO_CONNECT_TIMEOUT=3s
INFOSIMPLES_SERPRO_READ_TIMEOUT=10s
INFOSIMPLES_SERPRO_MAX_ATTEMPTS=3
INFOSIMPLES_SERPRO_RETRY_DELAY=200ms
INFOSIMPLES_SERPRO_CIRCUIT_FAILURE_THRESHOLD=5
INFOSIMPLES_SERPRO_CIRCUIT_OPEN_DURATION=30s
INFOSIMPLES_SERPRO_REQUESTS_PER_MINUTE=60
INFOSIMPLES_SERPRO_CACHE_TTL=5m
INFOSIMPLES_SERPRO_CACHE_MAX_ENTRIES=1000
INFOSIMPLES_SERPRO_UNKNOWN_STATUS_BLOCKS=true
INFOSIMPLES_SERPRO_BLOCKING_STATUSES=AUTUADO,PENDENTE
