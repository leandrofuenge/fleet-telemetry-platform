# Only development values belong in this file. Never commit deploy/compose/.env.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-local-password
JWT_SECRET=replace-with-a-long-random-development-secret

# SENATRAN/SERPRO homologation (replace only in deploy/compose/.env or secret vault)
INTEGRATION_PROFILES=docker,homologation,cte-homologation
INFOSIMPLES_SERPRO_RADAR_URL=https://CHANGE_ME_ENDPOINT_HOMOLOGACAO
INFOSIMPLES_TOKEN=CHANGE_ME_PROVIDER_TOKEN_MIN_16_CHARS
INFOSIMPLES_SERPRO_INTERNAL_API_KEY=CHANGE_ME_INTERNAL_API_KEY_MIN_16_CHARS

# CT-e 4.00 homologation endpoints (MT authorizer)
SEFAZ_CTE_AMBIENTE=homologacao
SEFAZ_CTE_AUTORIZACAO_URL=https://homologacao.sefaz.mt.gov.br/ctews2/services/CTeRecepcaoSincV4
SEFAZ_CTE_CONSULTA_URL=https://homologacao.sefaz.mt.gov.br/ctews2/services/CTeConsultaV4
SEFAZ_CTE_EVENTO_URL=https://homologacao.sefaz.mt.gov.br/ctews2/services/CTeRecepcaoEventoV4
SEFAZ_CTE_STATUS_URL=https://homologacao.sefaz.mt.gov.br/ctews2/services/CTeStatusServicoV4
SEFAZ_CERT_PATH=/run/secrets/sefaz-a1.p12
SEFAZ_CERT_PASSWORD=CHANGE_ME_CERTIFICATE_PASSWORD
SEFAZ_CERT_KEY_PASSWORD=CHANGE_ME_PRIVATE_KEY_PASSWORD
SEFAZ_CERT_TYPE=PKCS12
# Opcional; deixe vazio para usar o truststore padrão do Java.
SEFAZ_TRUSTSTORE_PATH=/run/secrets/sefaz-truststore.p12
SEFAZ_TRUSTSTORE_PASSWORD=CHANGE_ME_TRUSTSTORE_PASSWORD
SEFAZ_TRUSTSTORE_TYPE=PKCS12
SEFAZ_TLS_PROTOCOL=TLSv1.2
